# SubTrack — прод-окружение (/opt/subtrack/.env). Заполните и держите вне git.
# ВАЖНО: E2E_TEST_AUTH здесь НЕ задавать — иначе включится тестовый вход без Google.

# Пароль БД (сгенерируйте: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Секрет сессий (сгенерируйте: openssl rand -base64 32)
AUTH_SECRET=

# Публичный URL приложения (домен за Caddy/Cloudflare)
AUTH_URL=https://subtrack.gt1.one

# Google OAuth (console.cloud.google.com → Credentials → OAuth client;
# Authorized redirect URI: https://subtrack.gt1.one/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Начальные администраторы (через запятую) — сидятся в whitelist при старте
ADMIN_EMAILS=

# Прочее
APP_TZ=Europe/Kyiv
BASE_CURRENCY=USD

# Имя внешней сети Caddy (в этом инстансе — outline_internal)
CADDY_NETWORK=outline_internal

# ── DomainGuard (реестр доменов) ───────────────────────────────────────────
# Синхронизация доменов: read-only токен реестра.
DOMAINGUARD_URL="https://domains.example.com"
DOMAINGUARD_TOKEN=""
# Проекты реестра, попадающие в синхронизацию (через запятую). Пусто — все.
DOMAINGUARD_PROJECT_IDS=""
# Ответственный за импортированные домены (по умолчанию — первый админ).
DOMAINGUARD_OWNER_EMAIL=""
